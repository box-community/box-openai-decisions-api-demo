# Box Developer Token from the Box Developer Console (demo token expires periodically).
BOX_DEVELOPER_TOKEN=

# OpenAI API key. Decisions support in the Python SDK requires openai>=3.26.0.
OPENAI_API_KEY=
OPENAI_DECISIONS_MODEL=gpt-6-luna

# Box user IDs (not emails). Optional: without a reviewer, tasks are unassigned;
# without a specialist, no file collaboration is added.
BOX_REVIEWER_USER_ID=
BOX_SPECIALIST_USER_ID=

# ID from the File Request builder URL (/filerequest/<id>), not the public upload URL (/f/<token>).
BOX_FILE_REQUEST_TEMPLATE_ID=

# Used by seed.py to create/update the intake upload webhook.
# Set to the public HTTPS tunnel URL ending in /box-webhook (not localhost:8000).
BOX_WEBHOOK_ADDRESS=
# Used by demo.py to verify webhook requests; copy these from the Box app configuration.
BOX_WEBHOOK_PRIMARY_KEY=
BOX_WEBHOOK_SECONDARY_KEY=
PORT=8000
